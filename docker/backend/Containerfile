FROM python:3.14@sha256:e5de6bc932256f8138c2353023dc4fd24d010d72f6b5cb06be126f0a4cd53784

COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /usr/local/bin/uv
# uv sync tourne au démarrage, sur les réseaux du projet : sous podman, leur DNS (aardvark-dns)
# répond « Try again » à trop de téléchargements simultanés.
ENV UV_CONCURRENT_DOWNLOADS=4

# Bibliothèques système installées une fois, à la création de l'image
RUN apt-get update && apt-get install -y libldap2-dev libsasl2-dev libssl-dev && rm -rf /var/lib/apt/lists/*

# Define container app directory
RUN mkdir /app
WORKDIR /app/

# Copy entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && sed -i 's/\r$//' /entrypoint.sh

EXPOSE 4000

# IMPORTANT: use entrypoint, not command
RUN useradd --system --create-home --shell /usr/sbin/nologin app \
    && install -d -o app -g app /opt/docker_venv
USER app
ENTRYPOINT ["/entrypoint.sh"]
# CMD ["python", "app.py"]
