#########################################################################
# Skeleton of .env, it contains allrequired environment variables       #
# Do not edit it for your instance, edit your .env                      #
#########################################################################

#########################################################################
# Edit only .env in the Learnagement root directory,                    #
# or spécific env_XXX.env                                               #
#########################################################################

ENV=dev
SESSION_TIMEOUT=900
DOCKER_COMMAND=podman
DOCKER_COMPOSE_COMMAND="podman compose"
SSL_INTERNAL_DIR=./deploy/certs/internal/
SSL_EXTERNAL_DIR=./deploy/certs/external/

DEFAULT_TROMBI_PICTURE='/assets/Poly_Smiley_300x300.png'
PERS_TROMBI_DIR=PERS_TROMBI_DIR
ETU_TROMBI_DIR=ETU_TROMBI_DIR

LDAP_HOST=LDAP_HOST
LDAP_BASE_DN=LDAP_BASE_DN
LDAP_UID_ATTR=LDAP_UID_ATTR


CAS_HOST=CAS_HOST
CAS_ALLOWED_GROUPS_4_ADMINISTRATIF=CAS_ALLOWED_GROUPS_4_ADMINISTRATIF
CAS_ALLOWED_GROUPS_4_ENSEIGNANT=CAS_ALLOWED_GROUPS_4_ENSEIGNANT
CAS_ALLOWED_GROUPS_4_ETUDIANT=CAS_ALLOWED_GROUPS_4_ETUDIANT
CAS_ETUDIANTS_2_PROMO=CAS_ETUDIANTS_2_PROMO
CAS_MOCK_ENABLED=false

# Proxy CAS : outil de développement, lu par aucun code, jamais en production.
CAS_PROXY_HOST=CAS_PROXY_HOST
CAS_PROXY_LOOK4=CAS_PROXY_LOOK4

GOOGLE_MAPS_API_KEY=GOOGLE_MAPS_API_KEY

# Proxys dont l'API croit l'en-tête X-Forwarded-For (limite de débit par client réel) :
# réseaux des conteneurs et boucle locale, séparés par des virgules.
TRUSTED_PROXIES=10.88.0.0/16,10.89.0.0/16,172.16.0.0/12,127.0.0.0/8,::1/128

#########################################################################
# DO NOT EDIT ANY VARIABLE AFTER THIS LINE
#########################################################################

############################## Instance #################################

DOCKER_SSL_INTERNAL_DIR=/etc/ssl/learnagement-internal/
DOCKER_SSL_EXTERNAL_DIR=/etc/ssl/learnagement-external/
COMPOSE_PROJECT_NAME=learnagement_INSTANCE_NAME
INSTANCE_NAME=INSTANCE_NAME
CAS_SERVICE_TOKEN=CAS_SERVICE_TOKEN
JWT_SIGNING_KEY=JWT_SIGNING_KEY
INSTANCE_URL=INSTANCE_URL
INSTANCE_IP=INSTANCE_IP

##########################################################################
############################## Data Bases ################################
# Data Bases cannot be accessed from outside of docker

############################## MySQL ####################################

MYSQL_SERVER=learnagement_data_mysql_INSTANCE_NAME
MYSQL_PORT=3306
MYSQL_DB=learnagement
MYSQL_ROOT_PASSWORD=MYSQL_ROOT_PASSWORD
MYSQL_USER_LOGIN=learnagement
MYSQL_USER_PASSWORD=MYSQL_USER_PASSWORD

# Sauvegarde quotidienne (conteneur data_mysql_backup, en prod ; docs/prod.md)
BACKUP=true
BACKUP_AT=02:00
# Relatif à deploy/ (la compose) : ../database/backup est database/backup à la racine
BACKUP_DIRECTORY=../database/backup
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
# Appelée en POST (champ message) quand une sauvegarde échoue ; vide : pas d'alerte envoyée
BACKUP_ALERT_URL=


##########################################################################
############################## Back & Admin ##############################
# With "dev" mode, backend and admin systems are considered as frontend regarding the access
# With "prod" mode, by default, backend and admin systems can be accesss only from local host

############################## PhPMyAdmin ################################

PHPMYADMIN_DOCKER_PORT=80
PHPMYADMIN_PORT=8080

############################## Python Backend ############################

BACKEND_PYTHON_DOCKER_URL=learnagement_backend_python_INSTANCE_NAME
BACKEND_PYTHON_DOCKER_PORT=4000
BACKEND_PYTHON_PORT=4000

##########################################################################
############################## ETL ####################################

FRONT_ETL_DOCKER_PORT=6789
FRONT_ETL_PORT=6789

##########################################################################
############################## Fronts ####################################
# Public front urls are : INSTANCE_URL
# on port composed by 5 digits, the 1st one is INSTANCE_NUMBER, lasts are docker front port
# Example: for instance number 4 if the FRONT_PHP_DOCKER_PORT is 80, its public port is 40080

############################## PHP ######################################

FRONT_PHP_DOCKER_PORT=80
FRONT_PHP_PORT=80
FRONT_PHP_PROTOCOL=http

############################## Dash Plotly ##############################

FRONT_DASH_DOCKER_PORT=8050
FRONT_DASH_PORT=8050

############################## NextAuth #################################

FRONT_NEXTAUTH_DOCKER_PORT=3000
FRONT_NEXTAUTH_PORT=3000

#########################################################################
