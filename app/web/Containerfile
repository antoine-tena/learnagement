FROM php:8-apache@sha256:08af36df144462d84c7f16190557eec06cb9f656882685610b712a15eec54d46

RUN apt-get update && apt-get upgrade -y
RUN apt-get install sudo unzip wget -y
RUN docker-php-ext-install mysqli && docker-php-ext-enable mysqli

COPY --from=composer/composer:2-bin@sha256:269d47ef954e254227bccb35e3e40f642756abee44dded405e1fbb6f5e52af0c /composer /usr/bin/composer

WORKDIR /var/www/html

RUN a2enmod rewrite
RUN a2enmod ssl

COPY container/apache.conf /etc/apache2/sites-available/000-default.conf

# Working directory
WORKDIR /var/www/html

# Copie les vhosts
COPY container/ssl.conf /etc/apache2/sites-available/ssl.conf
#COPY default.conf /etc/apache2/sites-available/000-default.conf

# Activer le site SSL
# RUN a2ensite ssl.conf

# Copy entrypoint
COPY container/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && sed -i 's/\r$//' /entrypoint.sh

EXPOSE 80
EXPOSE 443

# IMPORTANT: use entrypoint, not command
ENTRYPOINT ["/entrypoint.sh"]
